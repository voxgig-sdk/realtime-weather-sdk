# Entity: collection

main: kit: entity: collection: {

  alias: field: {}

  fields: [
    {
      name: "coverage"
      req: false
      short: "Time coverage of the dataset"
      type: "`$STRING`"
    }
    {
      name: "datasetId"
      req: false
      short: "Unique identifier for the dataset"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the dataset"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Type of dataset"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "collection"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                example: 1459
                kind: "param"
                name: "id"
                orig: "collection_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/collections/{collectionId}/metadata"
          parts: [
            "collections"
            "{id}"
            "metadata"
          ]
          rename: {
            param: {
              collectionId: "id"
            }
          }
          select: {
            "$action": "metadata"
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.datasets`"
          }
        }
      ]
    }
  }



}
