# Entity: collection

main: kit: entity: collection: {

  alias: field: {}

  fields: [
    {
      name: "coverage"
      req: false
      short: "Time coverage of the dataset"
      type: "`$STRING`"
    }
    {
      name: "datasetId"
      req: false
      short: "Unique identifier for the dataset"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the dataset"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Type of dataset"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "collection"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                example: 1459
                kind: "param"
                name: "id"
                orig: "collection_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /collections/{collectionId}/metadata"
            json: "{\"operationId\":\"getCollectionMetadata\",\"parameters\":[{\"description\":\"The unique identifier for the collection. Use 1459 for Realtime Weather Readings.\",\"in\":\"path\",\"name\":\"collectionId\",\"required\":true,\"schema\":{\"example\":1459,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"agency\":{\"description\":\"Publishing agency\",\"example\":\"National Environment Agency (NEA)\",\"type\":\"string\"},\"collectionId\":{\"description\":\"Unique identifier for the collection\",\"example\":1459,\"type\":\"integer\"},\"datasets\":{\"description\":\"List of datasets in the collection\",\"items\":{\"properties\":{\"coverage\":{\"description\":\"Time coverage of the dataset\",\"example\":\"May 2016 to Feb 2026\",\"type\":\"string\"},\"datasetId\":{\"description\":\"Unique identifier for the dataset\",\"type\":\"string\"},\"name\":{\"description\":\"Name of the dataset\",\"type\":\"string\"},\"type\":{\"description\":\"Type of dataset\",\"enum\":[\"API\",\"file\"],\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"description\":{\"description\":\"Detailed description of the collection\",\"type\":\"string\"},\"title\":{\"description\":\"Title of the collection\",\"example\":\"Realtime Weather Readings across Singapore\",\"type\":\"string\"},\"updatedAt\":{\"description\":\"Last update timestamp\",\"format\":\"date-time\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Successful response with collection metadata\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"string\"},\"details\":{\"description\":\"Additional error details\",\"type\":\"object\"},\"message\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Collection not found\"},\"429\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"string\"},\"details\":{\"description\":\"Additional error details\",\"type\":\"object\"},\"message\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Rate limit exceeded\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"string\"},\"details\":{\"description\":\"Additional error details\",\"type\":\"object\"},\"message\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/collections/{collectionId}/metadata"
          rename: {
            param: {
              collectionId: "id"
            }
          }
          segments: [
            {
              lit: "collections"
            }
            {
              var: "id"
            }
            {
              lit: "metadata"
            }
          ]
          select: {
            "$action": "metadata"
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.datasets`"
          }
        }
      ]
    }
  }



}
